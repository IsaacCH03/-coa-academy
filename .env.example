# GitHub OAuth App (optional; the IDE works without these values)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# At least 32 cryptographically random characters; server only.
COA_SESSION_SECRET=
# Use http://localhost:3000 for development and https://cursoscoa.com in production.
COA_APP_URL=http://localhost:3000
# OAuth callback: <COA_APP_URL>/api/ide/github/callback

# Supabase Auth (public values only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Cloudflare Turnstile site key. Its secret belongs only in Supabase Dashboard.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
