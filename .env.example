# GitHub OAuth App (optional; the IDE works without these values)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# At least 32 cryptographically random characters; server only.
COA_SESSION_SECRET=
# Use http://localhost:3000 for development and https://cursoscoa.com in production.
COA_APP_URL=http://localhost:3000
# OAuth callback: <COA_APP_URL>/api/ide/github/callback
